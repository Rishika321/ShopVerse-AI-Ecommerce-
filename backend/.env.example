# Copy this file to .env and fill in your own values. Never commit the real .env file.

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=your_mongodb_connection_string_here

# Port the backend server runs on
PORT=4000

# Which origins are allowed to call this backend (CORS).
# Defaults to your local dev servers. When deployed, set these to your real
# deployed frontend/admin URLs (e.g. https://shopverse.vercel.app)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Secret used to sign login tokens - must be a long random string, never reused across projects.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_own_random_secret_here

# Admin panel login - change this password before deploying anywhere public
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password_here

# Google Gemini API key - free tier available at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test Mode keys - free, no KYC required for test mode
# Get these from https://dashboard.razorpay.com -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_test_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here

# Cloudinary - free tier available at https://cloudinary.com
# Get these from your Cloudinary Dashboard home page
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
